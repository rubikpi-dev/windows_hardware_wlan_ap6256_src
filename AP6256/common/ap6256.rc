#include <winver.h>
#include <ntdef.h>
#include "version.h"
#ifdef RC_INVOKED
#if DBG
#define VER_DBG VS_FF_DEBUG
#else
#define VER_DBG 0
#endif
#include <resource_model.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION AP6256_VER_MAJOR,AP6256_VER_MINOR,AP6256_VER_BUILD,AP6256_VER_REV
PRODUCTVERSION AP6256_VER_MAJOR,AP6256_VER_MINOR,AP6256_VER_BUILD,AP6256_VER_REV
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VER_DBG
FILEOS VOS_NT
FILETYPE VFT_DRV
FILESUBTYPE VFT2_DRV_NETWORK
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN

      VALUE "CompanyName", "rubikpi-dev"
      VALUE "FileDescription", "AP6256 WiFi SDIO Driver"
      VALUE "FileVersion", AP6256_VER_STR
      VALUE "InternalName", "ap6256.sys"

      VALUE "OriginalFilename", "ap6256.sys"
      VALUE "ProductName", "SparkLAN AP6256 802.11ac Wireless Adapter (SDIO)"
      VALUE "ProductVersion", AP6256_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409,1200
  END
END
#endif
